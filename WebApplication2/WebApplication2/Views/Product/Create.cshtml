@model WebApplication2.ViewModels.CreateViewModel
@{ ViewData["Title"] = "Ajouter un produit"; }
<div class="form-card"><div class="text-center mb-4"><i class="bi bi-box-seam text-primary fs-1"></i><h1 class="page-title mt-2 mb-1">Ajouter un produit</h1><p class="text-muted small">Complétez les informations du produit.</p></div><form enctype="multipart/form-data" asp-action="Create"><div asp-validation-summary="All" class="text-danger small"></div><div class="row g-3"><div class="col-12"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Price" class="form-label"></label><div class="input-group"><input asp-for="Price" class="form-control" /><span class="input-group-text">DT</span></div><span asp-validation-for="Price" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="QteStock" class="form-label"></label><input asp-for="QteStock" class="form-control" /><span asp-validation-for="QteStock" class="text-danger small"></span></div><div class="col-12"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select></div><div class="col-12"><label asp-for="ImagePath" class="form-label"></label><input asp-for="ImagePath" class="form-control custom-file-input" /><span class="form-text">JPG, PNG ou autre image produit.</span></div></div><div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Créer</button><a asp-action="Index" class="btn btn-outline-secondary">Annuler</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>$(document).ready(function(){$('.custom-file-input').on('change',function(){$(this).next('.custom-file-label').html($(this).val().split('\\').pop());});});</script> }
