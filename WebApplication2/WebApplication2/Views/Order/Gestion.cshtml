@model IEnumerable<WebApplication2.Models.Order>
@using WebApplication2.Models
@{ ViewData["Title"] = "Gestion des commandes"; string? filtre = ViewBag.Statut; }
<h2 class="mt-3">Gestion des commandes</h2>
<form method="get" asp-action="Gestion" class="row g-2 mb-3"><div class="col-auto"><select name="statut" class="form-select"><option value="">Tous les statuts</option>@foreach (var status in OrderStatus.Tous) { <option value="@status" selected="@(status == filtre)">@status</option> }</select></div><div class="col-auto"><button class="btn btn-primary">Filtrer</button></div></form>
<table class="table table-hover"><thead><tr><th>N°</th><th>Client</th><th>Date</th><th>Total</th><th>Statut</th><th>Changer</th><th></th></tr></thead><tbody>@foreach (var order in Model) { bool cancelled = order.Status == OrderStatus.Annulee; <tr><td>@order.Id</td><td>@order.Email</td><td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td><td>@order.TotalAmount.ToString("0.00") DT</td><td><span class="badge bg-@OrderStatus.Couleur(order.Status)">@order.Status</span></td><td><form asp-action="ChangerStatut" asp-route-id="@order.Id" method="post" class="d-flex gap-1"><select name="statut" class="form-select form-select-sm" disabled="@cancelled">@foreach (var status in OrderStatus.Tous) { <option value="@status" selected="@(status == order.Status)">@status</option> }</select><button class="btn btn-sm btn-success" disabled="@cancelled">OK</button></form></td><td><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Détails</a></td></tr> }</tbody></table>
