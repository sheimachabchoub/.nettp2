@model WebApplication2.Models.Order
@using WebApplication2.Models
@{ ViewData["Title"] = "Confirmation"; }
<div class="auth-card text-center"><i class="bi bi-check-circle-fill text-success" style="font-size:4rem"></i>
    <h1 class="mt-3">Commande confirmée</h1>
    <p class="text-muted">Merci @Model.FirstName, votre commande a bien été enregistrée.</p>
    <div class="alert alert-light text-start"><strong>Commande n°@Model.Id</strong><br /><span class="badge bg-@OrderStatus.Couleur(Model.Status)">@Model.Status</span><hr /><div class="d-flex justify-content-between"><span>Sous-total</span><strong>@Model.SubTotal.ToString("0.00") DT</strong></div><div class="d-flex justify-content-between"><span>Livraison</span><strong>@Model.ShippingPrice.ToString("0.00") DT</strong></div><div class="d-flex justify-content-between mt-2"><span>Total</span><strong class="product-price">@Model.TotalAmount.ToString("0.00") DT</strong></div></div><div class="d-flex justify-content-center gap-2"><a asp-controller="Order" asp-action="MesCommandes" class="btn btn-primary">Mes commandes</a><a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">Continuer mes achats</a></div></div>
