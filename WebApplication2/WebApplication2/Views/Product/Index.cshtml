@model IEnumerable<WebApplication2.Models.Product>
@{
    ViewData["Title"] = "Produits";
    bool gestion = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="page-head">
    <div>
        <h1>Nos produits</h1>
        <p class="subtitle">@Model.Count() produit(s) affiché(s)</p>
    </div>
    @if (gestion)
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Ajouter un produit</a>
    }
</div>

@if (!Model.Any())
{
    <div class="card text-center p-5">
        <i class="bi bi-search fs-1 text-muted"></i>
        <h5 class="mt-3">Aucun produit trouvé</h5>
        <a asp-action="Index" class="btn btn-outline-primary mt-2 mx-auto">Voir tous les produits</a>
    </div>
}

<div class="row g-4">
    @foreach (var product in Model)
    {
        <div class="col-sm-6 col-lg-3">
            <div class="card product-card">
                <a asp-action="Details" asp-route-id="@product.ProductId" class="product-img">
                    @if (!string.IsNullOrEmpty(product.Image))
                    {
                        <img src="~/images/@product.Image" alt="@product.Name" />
                    }
                    else
                    {
                        <i class="bi bi-image"></i>
                    }
                </a>

                <div class="card-body d-flex flex-column">
                    <span class="product-cat align-self-start">@product.Category?.CategoryName</span>
                    <a asp-action="Details" asp-route-id="@product.ProductId" class="product-name">@product.Name</a>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="product-price">@product.Price.ToString("0.00") <small>DT</small></span>
                        @if (product.QteStock == 0)
                        {
                            <span class="stock stock-out"><i class="bi bi-x-circle me-1"></i>Rupture</span>
                        }
                        else if (product.QteStock <= 3)
                        {
                            <span class="stock stock-low"><i class="bi bi-exclamation-circle me-1"></i>Plus que @product.QteStock</span>
                        }
                        else
                        {
                            <span class="stock stock-ok"><i class="bi bi-check-circle me-1"></i>En stock</span>
                        }
                    </div>

                    <div class="product-actions mt-auto">
                        <a asp-action="Details" asp-route-id="@product.ProductId"
                           class="btn btn-outline-secondary" title="Voir le produit">
                            <i class="bi bi-eye"></i>
                        </a>
                        @if (product.QteStock > 0)
                        {
                            <a asp-controller="Panier" asp-action="AddProduct" asp-route-id="@product.ProductId"
                               class="btn btn-primary btn-add">
                                <i class="bi bi-cart-plus me-1"></i>Ajouter
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-add" disabled>Indisponible</button>
                        }
                    </div>

                    @if (gestion)
                    {
                        <div class="admin-actions">
                            <a asp-action="Edit" asp-route-id="@product.ProductId"
                               class="btn btn-sm btn-outline-primary flex-fill"><i class="bi bi-pencil me-1"></i>Modifier</a>
                            <a asp-action="Delete" asp-route-id="@product.ProductId"
                               class="btn btn-sm btn-outline-danger flex-fill"><i class="bi bi-trash me-1"></i>Supprimer</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Pagination -->
@if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
{
    <nav class="mt-5">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-categoryId="@ViewBag.CategoryId" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
