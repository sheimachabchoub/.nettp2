@using WebApplication2.Models.Help
@model IEnumerable<Item>
@{ ViewData["Title"] = "Mon panier"; var items = Model?.ToList() ?? new List<Item>(); }
<div class="page-head"><div><h1>Mon panier</h1><p class="subtitle">Vérifiez vos articles avant de commander</p></div><a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left me-1"></i>Continuer mes achats</a></div>
@if (!items.Any()) { <div class="card text-center p-5"><i class="bi bi-cart-x fs-1 text-muted"></i><h5 class="mt-3">Votre panier est vide</h5><a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-2 mx-auto">Voir les produits</a></div> } else { <div class="row g-4"><div class="col-lg-8"><div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Produit</th><th>Prix</th><th>Quantité</th><th>Total</th><th></th></tr></thead><tbody>@foreach (var item in items) { <tr id="row-@item.Prod.ProductId"><td><img src="~/images/@(item.Prod.Image ?? "noimage.jpg")" width="60" height="60" class="me-2" alt="@item.Description" />@item.Description</td><td>@item.UnitPrice.ToString("0.00") DT</td><td><div class="btn-group btn-group-sm"><a class="btn btn-outline-primary MinProducts" data-id="@item.Prod.ProductId" asp-action="DecreaseProduct" asp-route-id="@item.Prod.ProductId"><i class="bi bi-dash-lg"></i></a><span class="btn btn-light" id="quantite_@item.Prod.ProductId">@item.quantite</span><a class="btn btn-outline-primary PlusProducts" data-id="@item.Prod.ProductId" asp-action="IncreaseProduct" asp-route-id="@item.Prod.ProductId"><i class="bi bi-plus-lg"></i></a></div></td><td id="total_@item.Prod.ProductId">@((item.UnitPrice * item.quantite).ToString("0.00")) DT</td><td><a class="btn btn-sm btn-outline-danger RemoveLink" data-id="@item.Prod.ProductId" asp-action="RemoveProduct" asp-route-id="@item.Prod.ProductId"><i class="bi bi-trash"></i></a></td></tr> }</tbody></table></div></div></div><div class="col-lg-4"><div class="card p-4 sticky-top" style="top:90px"><h5>Récapitulatif</h5><div class="d-flex justify-content-between border-bottom py-3"><span>Sous-total</span><strong id="totalapayer">@items.Sum(i => i.TotalPrice).ToString("0.00") DT</strong></div><div class="d-flex justify-content-between py-3"><strong>Total</strong><strong class="product-price" id="recap">@items.Sum(i => i.TotalPrice).ToString("0.00") DT</strong></div><a asp-action="Checkout" class="btn btn-primary w-100"><i class="bi bi-credit-card me-1"></i>Passer la commande</a></div></div></div> }
