@using Microsoft.AspNetCore.Identity
@using WebApplication2.Models.Help
@inject SignInManager<IdentityUser> SignInManager
@{
    string ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    int nbArticles = ListeCart.Instance.Items.Sum(i => i.quantite);
    string Actif(string c, string a = "") =>
        (ctrl == c && (a == "" || act == a)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DotNetShop</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- ===================== NAVBAR ===================== -->
    <header>
        <nav class="navbar navbar-expand-lg shop-navbar sticky-top">
            <div class="container">

                <!-- Bouton du menu latéral des catégories (id utilisé par site.js) -->
                <button type="button" class="btn btn-icon me-2" id="toggleMenu" title="Catégories">
                    <i class="bi bi-grid-3x3-gap"></i>
                </button>

                <a class="navbar-brand shop-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo"><i class="bi bi-bag-heart-fill"></i></span>
                    <span>DotNet<span class="text-primary">Shop</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <!-- Liens principaux -->
                    <ul class="navbar-nav mx-lg-auto">
                        <li class="nav-item">
                            <a class="nav-link @Actif("Home")" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Actif("Product")" asp-controller="Product" asp-action="Index">Produits</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Actif("Category")" asp-controller="Category" asp-action="Index">Catégories</a>
                        </li>

                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @Actif("Admin")" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Administration</a>
                                <ul class="dropdown-menu shadow-sm">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Tableau de bord</a></li>
                                    <li><a class="dropdown-item" asp-controller="Order" asp-action="Gestion"><i class="bi bi-receipt me-2"></i>Commandes</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="ListRoles"><i class="bi bi-people me-2"></i>Rôles</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="CreateRole"><i class="bi bi-person-plus me-2"></i>Créer un rôle</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- Recherche -->
                    <form class="shop-search my-2 my-lg-0 me-lg-3" asp-controller="Product" asp-action="Search">
                        <i class="bi bi-search"></i>
                        <input class="form-control" type="search" placeholder="Rechercher un produit..." name="val">
                    </form>

                    <!-- Panier + compte -->
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-icon position-relative" asp-controller="Panier" asp-action="Index" title="Mon panier">
                            <i class="bi bi-cart3"></i>
                            @if (nbArticles > 0)
                            {
                                <span class="cart-badge">@nbArticles</span>
                            }
                        </a>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="dropdown">
                                <button class="btn btn-account dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i>
                                    <span class="d-none d-xl-inline">@User.Identity!.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><h6 class="dropdown-header">@User.Identity!.Name</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Order" asp-action="MesCommandes"><i class="bi bi-bag-check me-2"></i>Mes commandes</a></li>
                                    <li><a class="dropdown-item" asp-controller="Panier" asp-action="Index"><i class="bi bi-cart3 me-2"></i>Mon panier</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" asp-controller="Account" asp-action="Logout">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm px-3" asp-controller="Account" asp-action="Login">Connexion</a>
                            <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Inscription</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- ===================== CONTENU ===================== -->
    <div class="container flex-grow-1 py-4">
        <div class="row">
            <!-- Menu latéral des catégories (ids utilisés par site.js) -->
            <div class="col-md-2" id="sidebar" style="display: none;">
                @await Html.PartialAsync("_CategoriesMenu", ViewData["Categories"])
            </div>

            <div class="col-md-12" id="mainContent">
                <main role="main">
                    @if (TempData["Info"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill"></i>
                            <div>@TempData["Info"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Erreur"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>@TempData["Erreur"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <!-- ===================== FOOTER ===================== -->
    <footer class="shop-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <div class="shop-brand text-white mb-2">
                        <span class="brand-logo"><i class="bi bi-bag-heart-fill"></i></span>
                        DotNetShop
                    </div>
                    <p class="mb-0">Hygiène, beauté et alimentation : vos produits du quotidien livrés chez vous partout en Tunisie.</p>
                </div>
                <div class="col-6 col-md-3">
                    <h6>Boutique</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Product" asp-action="Index">Produits</a></li>
                        <li><a asp-controller="Category" asp-action="Index">Catégories</a></li>
                        <li><a asp-controller="Panier" asp-action="Index">Mon panier</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4">
                    <h6>Contact</h6>
                    <ul class="list-unstyled">
                        <li><i class="bi bi-telephone me-2"></i>+216 70 000 000</li>
                        <li><i class="bi bi-envelope me-2"></i>contact@dotnetshop.tn</li>
                        <li><i class="bi bi-geo-alt me-2"></i>Sfax, Tunisie</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; 2026 DotNetShop - <a asp-controller="Home" asp-action="Privacy">Confidentialité</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/CustomScript.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
