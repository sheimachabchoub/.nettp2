@model WebApplication2.Models.Product
@{ ViewData["Title"] = "Détails du produit"; bool gestion = User.IsInRole("Admin") || User.IsInRole("Manager"); }
<div class="page-head"><div><h1>Détails du produit</h1><p class="subtitle">Informations et disponibilité</p></div><a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left me-1"></i>Retour</a></div>
<div class="card p-4"><div class="row g-4 align-items-center"><div class="col-md-6"><div class="product-img"><img src="~/images/@(Model.Image ?? "noimage.jpg")" asp-append-version="true" alt="@Model.Name" /></div></div><div class="col-md-6"><span class="product-cat">@(Model.Category?.CategoryName ?? "Sans catégorie")</span><h1 class="product-name fs-2 mt-3">@Model.Name</h1><div class="product-price my-3">@Model.Price.ToString("0.00") <small>DT</small></div>@if (Model.QteStock == 0) { <span class="stock stock-out"><i class="bi bi-x-circle me-1"></i>Rupture de stock</span> } else if (Model.QteStock <= 3) { <span class="stock stock-low"><i class="bi bi-exclamation-circle me-1"></i>Plus que @Model.QteStock</span> } else { <span class="stock stock-ok"><i class="bi bi-check-circle me-1"></i>En stock (@Model.QteStock)</span> }<div class="mt-4">@if (Model.QteStock > 0) { <a asp-controller="Panier" asp-action="AddProduct" asp-route-id="@Model.ProductId" class="btn btn-primary"><i class="bi bi-cart-plus me-1"></i>Ajouter au panier</a> } @if (gestion) { <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary ms-2"><i class="bi bi-pencil"></i></a><a asp-action="Delete" asp-route-id="@Model.ProductId" class="btn btn-outline-danger ms-1"><i class="bi bi-trash"></i></a> }</div></div></div></div>
