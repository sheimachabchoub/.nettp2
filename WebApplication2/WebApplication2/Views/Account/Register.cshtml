@model RegisterViewModel
@{
    ViewData["Title"] = "Inscription";
}

<div class="card auth-card">
    <div class="auth-icon"><i class="bi bi-person-plus"></i></div>
    <h1 class="text-center h3 mb-1">Créer un compte</h1>
    <p class="text-center text-muted mb-4">Inscrivez-vous pour commander et suivre vos achats</p>

    <form method="post">
        <div asp-validation-summary="All" class="text-danger small mb-2"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Adresse email</label>
            <div class="input-icon">
                <i class="bi bi-envelope"></i>
                <input asp-for="Email" class="form-control" placeholder="exemple@gmail.com" />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Mot de passe</label>
            <div class="input-icon">
                <i class="bi bi-lock"></i>
                <input asp-for="Password" class="form-control" placeholder="6 caractères, lettres et chiffres" />
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label">Confirmer le mot de passe</label>
            <div class="input-icon">
                <i class="bi bi-lock-fill"></i>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2">
            <i class="bi bi-person-check me-1"></i>Créer mon compte
        </button>
    </form>

    <p class="text-center text-muted mt-4 mb-0">
        Déjà inscrit ?
        <a asp-action="Login" class="fw-semibold">Connectez-vous</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
