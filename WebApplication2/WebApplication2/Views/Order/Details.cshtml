@model WebApplication2.Models.Order
@using WebApplication2.Models
@{ ViewData["Title"] = "Commande n°" + Model.Id; }
<h2 class="mt-3">Commande n°@Model.Id <span class="badge bg-@OrderStatus.Couleur(Model.Status)">@Model.Status</span></h2>
<p class="text-muted">Passée le @Model.OrderDate.ToString("dd/MM/yyyy à HH:mm") par @Model.Email</p>
<table class="table"><thead><tr><th>Produit</th><th>Prix</th><th>Quantité</th><th>Total</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.ProductName</td><td>@item.Price.ToString("0.00")</td><td>@item.Quantity</td><td>@((item.Price * item.Quantity).ToString("0.00"))</td></tr> }</tbody></table>
<h5>Livraison</h5><p>@Model.FirstName @Model.LastName<br />@Model.Address, @Model.ZipCode @Model.City<br />Tél : @Model.Phone<br />Mode : @Model.DeliveryMethod?.Nom (@Model.DeliveryMethod?.Delai)<br />Paiement : @Model.PaymentMethod</p>
<p>Sous-total : @Model.SubTotal.ToString("0.00") DT<br />Livraison : @Model.ShippingPrice.ToString("0.00") DT<br /><strong>Total : @Model.TotalAmount.ToString("0.00") DT</strong></p>
