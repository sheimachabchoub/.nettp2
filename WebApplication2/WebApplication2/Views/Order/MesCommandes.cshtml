@model IEnumerable<WebApplication2.Models.Order>
@using WebApplication2.Models
@{ ViewData["Title"] = "Mes commandes"; }
<h2 class="mt-3">Mes commandes</h2>
@if (!Model.Any()) { <div class="alert alert-info">Vous n'avez encore passé aucune commande. <a asp-controller="Product" asp-action="Index">Voir les produits</a></div> }
else { <table class="table table-hover"><thead><tr><th>N°</th><th>Date</th><th>Livraison</th><th>Total</th><th>Statut</th><th></th></tr></thead><tbody>@foreach (var order in Model) { <tr><td>@order.Id</td><td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td><td>@order.DeliveryMethod?.Nom</td><td>@order.TotalAmount.ToString("0.00") DT</td><td><span class="badge bg-@OrderStatus.Couleur(order.Status)">@order.Status</span></td><td><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-primary">Détails</a>@if (order.Status == OrderStatus.EnAttente) { <form asp-action="Annuler" asp-route-id="@order.Id" method="post" class="d-inline ms-1"><button class="btn btn-sm btn-outline-danger" type="submit">Annuler</button></form> }</td></tr> }</tbody></table> }
