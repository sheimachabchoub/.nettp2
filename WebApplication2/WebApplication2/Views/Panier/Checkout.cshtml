@model WebApplication2.ViewModels.OrderViewModel
@using System.Globalization
@{ ViewData["Title"] = "Passer la commande"; var inv = CultureInfo.InvariantCulture; }
<h1 class="page-title">Passer la commande</h1>
<form asp-action="Checkout" method="post"><div class="row g-4"><div class="col-lg-8"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="card p-4 mb-3"><h2 class="section-title"><span class="badge bg-primary rounded-circle me-2">1</span>Adresse de livraison</h2><div class="row g-3 mt-1"><div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger small"></span></div><div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="ZipCode" class="form-label"></label><input asp-for="ZipCode" class="form-control" /><span asp-validation-for="ZipCode" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger small"></span></div></div></div><div class="card p-4 mb-3"><h2 class="section-title"><span class="badge bg-primary rounded-circle me-2">2</span>Mode de livraison</h2><div class="row g-2 mt-2">@foreach (var delivery in Model.DeliveryMethods) { <div class="col-md-6"><label class="card p-3 h-100"><input class="form-check-input mode-livraison" type="radio" asp-for="DeliveryMethodId" value="@delivery.Id" data-prix="@delivery.Prix.ToString(inv)" /><strong class="mt-2">@delivery.Nom</strong><small class="text-muted">@delivery.Delai · @delivery.Prix.ToString("0.00", inv) DT</small></label></div> }</div><span asp-validation-for="DeliveryMethodId" class="text-danger small"></span></div><div class="card p-4 mb-3"><h2 class="section-title"><span class="badge bg-primary rounded-circle me-2">3</span>Vos articles</h2><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Produit</th><th>Prix</th><th>Quantité</th><th>Total</th></tr></thead><tbody>@foreach (var item in Model.CartItems) { <tr><td>@item.ProductName</td><td>@item.Price.ToString("0.00", inv) DT</td><td>@item.Quantity</td><td>@((item.Price * item.Quantity).ToString("0.00", inv)) DT</td></tr> }</tbody></table></div></div><div class="card p-4"><h2 class="section-title"><span class="badge bg-primary rounded-circle me-2">4</span>Paiement</h2><div class="d-flex flex-wrap gap-4 mt-3"><label><input type="radio" asp-for="PaymentMethod" value="Carte" /> Carte bancaire</label><label><input type="radio" asp-for="PaymentMethod" value="PayPal" /> PayPal</label><label><input type="radio" asp-for="PaymentMethod" value="Livraison" /> À la livraison</label></div></div></div><div class="col-lg-4"><div class="card p-4 sticky-lg-top" style="top:1rem"><h2 class="h5">Récapitulatif</h2><div id="recap" data-soustotal="@Model.SubTotal.ToString(inv)"><div class="d-flex justify-content-between py-2"><span>Sous-total</span><strong>@Model.SubTotal.ToString("0.00", inv) DT</strong></div><div class="d-flex justify-content-between py-2"><span>Livraison</span><strong><span id="fraisLivraison">@Model.ShippingPrice.ToString("0.00", inv)</span> DT</strong></div><hr /><div class="d-flex justify-content-between py-2"><span>Total</span><strong class="product-price"><span id="totalCommande">@Model.TotalAmount.ToString("0.00", inv)</span> DT</strong></div></div><button type="submit" class="btn btn-primary w-100 mt-3"><i class="bi bi-check2-circle me-2"></i>Valider la commande</button><a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Retour au panier</a></div></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>document.querySelectorAll('.mode-livraison').forEach(r=>r.addEventListener('change',function(){let s=parseFloat(document.getElementById('recap').dataset.soustotal),f=parseFloat(this.dataset.prix);document.getElementById('fraisLivraison').textContent=f.toFixed(2);document.getElementById('totalCommande').textContent=(s+f).toFixed(2)}));</script> }
