@model WebApplication2.ViewModels.DashboardViewModel
@using WebApplication2.Models
@{ ViewData["Title"] = "Tableau de bord"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><span class="text-primary small fw-semibold text-uppercase">Administration</span><h1 class="page-title mb-0">Tableau de bord</h1></div><a asp-controller="Order" asp-action="Gestion" class="btn btn-outline-primary"><i class="bi bi-box-seam me-1"></i>Gérer les commandes</a></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="stat-card bg-primary"><i class="bi bi-box-seam"></i><strong>@Model.NbProduits</strong><span>Produits</span></div></div><div class="col-md-3"><div class="stat-card bg-success"><i class="bi bi-receipt"></i><strong>@Model.NbCommandes</strong><span>Commandes (@Model.NbEnAttente en attente)</span></div></div><div class="col-md-3"><div class="stat-card bg-warning text-dark"><i class="bi bi-currency-dollar"></i><strong>@Model.ChiffreAffaires.ToString("0.00") DT</strong><span>Chiffre d'affaires</span></div></div><div class="col-md-3"><div class="stat-card bg-danger"><i class="bi bi-exclamation-circle"></i><strong>@Model.ProduitsEnRupture.Count</strong><span>Ruptures de stock</span></div></div></div>
<div class="table-wrap"><h2 class="section-title mb-3">Dernières commandes</h2><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>N°</th><th>Client</th><th>Date</th><th>Total</th><th>Statut</th></tr></thead><tbody>@foreach (var order in Model.DernieresCommandes) { <tr><td><a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id">#@order.Id</a></td><td>@order.Email</td><td>@order.OrderDate.ToString("dd/MM/yyyy")</td><td>@order.TotalAmount.ToString("0.00") DT</td><td><span class="badge bg-@OrderStatus.Couleur(order.Status)">@order.Status</span></td></tr> }</tbody></table></div></div>
